# Local development only. Do not put production secrets in this file.
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_plus
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional. When SMTP_HOST is empty, development keeps auth links in the local mailbox page.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus+ <noreply@localhost>

# Voice and video. Leave MEDIA_SECRET empty to keep calls unavailable.
# When it is set, run `npm run media` beside the app. Browsers must be able to reach MEDIA_PUBLIC_HOST.
MEDIA_SECRET=
MEDIA_PUBLIC_HOST=127.0.0.1
MEDIA_PORT=3001
MEDIA_TURN_PORT=3478
